{
  "rewrites": [
    {
      "source": "/__/auth/:path*",
      "destination": "https://audiofactory-eia.firebaseapp.com/__/auth/:path*"
    },
    {
      "source": "/__/firebase/:path*",
      "destination": "https://audiofactory-eia.firebaseapp.com/__/firebase/:path*"
    },
    {
      "source": "/api/(.*)",
      "destination": "/api/index.ts"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}

