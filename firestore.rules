rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny all access
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isSignedIn() && (
        exists(/databases/$(database)/documents/admins/$(request.auth.uid)) ||
        (request.auth.token.email != null && request.auth.token.email_verified == true && request.auth.token.email == 'connectedtorajib@gmail.com')
      );
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isValidHmacId(id) {
      return id is string && id.size() == 64 && id.matches('^[a-f0-9]{64}$');
    }

    function isValidTimestampString(ts) {
      return ts is string && ts.size() >= 10 && ts.size() <= 64;
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // Validation helper for AudioProject
    function isValidAudioProject(data) {
      let authUid = request.auth.uid;
      return data.keys().hasAll(['id', 'title', 'userId', 'lines']) &&
             data.id is string && isValidId(data.id) &&
             data.title is string && data.title.size() <= 256 &&
             data.userId == authUid &&
             data.lines is list && data.lines.size() <= 200 &&
             (!('summary' in data) || (data.summary is string && data.summary.size() <= 4000)) &&
             (!('format' in data) || (data.format is string && data.format.size() <= 100)) &&
             (!('style' in data) || (data.style is string && data.style.size() <= 100)) &&
             (!('speakerCount' in data) || (data.speakerCount is number)) &&
             (!('speakers' in data) || (data.speakers is list && data.speakers.size() <= 20)) &&
             !('role' in data) && !('isAdmin' in data) && !('plan' in data) && !('quota' in data);
    }

    // Validation helper for Audio Monologue
    function isValidAudioMonologue(data) {
      let authUid = request.auth.uid;
      return data.keys().hasAll(['id', 'title', 'voice', 'text', 'userId']) &&
             data.id is string && isValidId(data.id) &&
             data.title is string && data.title.size() <= 256 &&
             data.voice is string && data.voice.size() <= 100 &&
             data.text is string && data.text.size() <= 50000 &&
             data.userId == authUid &&
             (!('styleId' in data) || (data.styleId is string && data.styleId.size() <= 100)) &&
             !('role' in data) && !('isAdmin' in data) && !('plan' in data);
    }

    function isValidMonologue(data) {
      return isValidAudioMonologue(data);
    }

    // Validation helper for User Profile
    function isValidUserProfile(data) {
      let authUid = request.auth.uid;
      return data.userId == authUid &&
             (!('displayName' in data) || (data.displayName is string && data.displayName.size() <= 128)) &&
             (!('email' in data) || (data.email is string && data.email.size() <= 256)) &&
             !('role' in data) && !('isAdmin' in data) && !('plan' in data) &&
             !('planId' in data) && !('entitlement' in data) && !('quota' in data);
    }

    // Validation helper for Early Birds Consent object
    function isValidEarlyBirdConsent(consent) {
      return consent is map &&
             consent.keys().hasAll(['programmeCommunication', 'marketingUpdates', 'policyVersion']) &&
             consent.keys().hasOnly(['programmeCommunication', 'marketingUpdates', 'policyVersion']) &&
             consent.programmeCommunication == true &&
             consent.marketingUpdates is bool &&
             consent.policyVersion == '1.0';
    }

    // Validation helper for Early Birds Application (Create-Only with Server Timestamp)
    function isValidEarlyBirdApplication(data) {
      return data.keys().hasAll([
               'name',
               'email',
               'normalizedEmail',
               'interests',
               'androidVersion',
               'programme',
               'appVersion',
               'status',
               'selectionStatus',
               'testingInvitationSent',
               'testingCompleted',
               'testingFeedbackReceived',
               'consent',
               'source',
               'createdAt',
               'updatedAt'
             ]) &&
             data.keys().hasOnly([
               'name',
               'email',
               'normalizedEmail',
               'interests',
               'androidVersion',
               'programme',
               'appVersion',
               'status',
               'selectionStatus',
               'testingInvitationSent',
               'testingCompleted',
               'testingFeedbackReceived',
               'consent',
               'source',
               'createdAt',
               'updatedAt'
             ]) &&
             data.name is string && data.name.size() >= 1 && data.name.size() <= 120 &&
             data.email is string && data.email.size() >= 5 && data.email.size() <= 254 && data.email.matches('^[^@\\s]+@[^@\\s]+\\.[^@\\s]+$') &&
             data.normalizedEmail is string && data.normalizedEmail.size() >= 5 && data.normalizedEmail.size() <= 254 &&
             data.interests is list && data.interests.size() <= 6 &&
             (data.interests.size() == 0 || (data.interests[0] is string && data.interests[0].size() <= 60)) &&
             data.androidVersion is string && data.androidVersion.size() >= 1 && data.androidVersion.size() <= 40 &&
             data.programme == 'AudioFACTORY Early Birds' &&
             data.appVersion == '2.0.0' &&
             data.status == 'applied' &&
             data.selectionStatus == 'pending' &&
             data.testingInvitationSent == false &&
             data.testingCompleted == false &&
             data.testingFeedbackReceived == false &&
             isValidEarlyBirdConsent(data.consent) &&
             data.source == 'early_birds_landing_page' &&
             data.createdAt == request.time &&
             data.updatedAt == request.time &&
             !('confirmEmail' in data) &&
             !('password' in data);
    }

    // Admins collection for role checking
    match /admins/{adminId} {
      allow read: if isSignedIn() && (request.auth.uid == adminId || isAdmin());
      allow write: if false;
    }

    // Early Birds v2.0.0 Founding Tester Applications
    // - No public listing/enumeration allowed (allow list: if isAdmin())
    // - Server-salted HMAC-SHA256 document ID prevents unauthorized lookup and guarantees uniqueness
    // - Create-only for new applications with strict schema and server timestamps; never overwrites existing records
    match /early_birds/{applicantId} {
      allow get: if isAdmin() || isValidHmacId(applicantId);
      allow list: if isAdmin();
      allow create: if isValidHmacId(applicantId) && isValidEarlyBirdApplication(incoming());
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    // User data trees
    match /users/{userId} {
      allow read, write: if isOwner(userId) || isAdmin();

      // User Profile
      match /profile/{profileId} {
        allow get, list: if isOwner(userId) || isAdmin();
        allow create: if (isOwner(userId) || isAdmin()) && isValidId(profileId) && isValidUserProfile(incoming());
        allow update: if (isOwner(userId) || isAdmin()) && isValidId(profileId) && isValidUserProfile(incoming());
        allow delete: if isOwner(userId) || isAdmin();
      }

      // Audio Projects subcollection
      match /projects/{projectId} {
        allow get, list: if isOwner(userId) || isAdmin();
        allow create: if (isOwner(userId) || isAdmin()) && isValidId(projectId) && isValidAudioProject(incoming());
        allow update: if (isOwner(userId) || isAdmin()) && isValidId(projectId) && isValidAudioProject(incoming()) && incoming().userId == existing().userId && incoming().createdAt == existing().createdAt;
        allow delete: if isOwner(userId) || isAdmin();
      }

      // Monologues subcollection
      match /monologues/{monologueId} {
        allow get, list: if isOwner(userId) || isAdmin();
        allow create: if (isOwner(userId) || isAdmin()) && isValidId(monologueId) && isValidAudioMonologue(incoming());
        allow update: if (isOwner(userId) || isAdmin()) && isValidId(monologueId) && isValidAudioMonologue(incoming()) && incoming().userId == existing().userId && incoming().createdAt == existing().createdAt;
        allow delete: if isOwner(userId) || isAdmin();
      }

      // Daily usage records (read-only for clients, admin/server write)
      match /usage/{dateId} {
        allow get: if isOwner(userId) || isAdmin();
        allow list: if isOwner(userId) || isAdmin();
        allow write: if false;
      }

      // Entitlements ledger (read-only for clients, server write)
      match /entitlements/{docId} {
        allow get: if isOwner(userId) || isAdmin();
        allow list: if isOwner(userId) || isAdmin();
        allow write: if false;
      }

      // Purchases log (read-only for clients, server write)
      match /purchases/{purchaseId} {
        allow get: if isOwner(userId) || isAdmin();
        allow list: if isOwner(userId) || isAdmin();
        allow write: if false;
      }

      // Generation Jobs (read-only for clients, server write)
      match /generationJobs/{jobId} {
        allow get: if isOwner(userId) || isAdmin();
        allow list: if isOwner(userId) || isAdmin();
        allow write: if false;
      }
    }
  }
}
