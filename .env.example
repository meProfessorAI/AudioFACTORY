# AudioFACTORY Environment Variables
# Server-side API keys (NEVER exposed to browser)
GEMINI_API_KEY=
ELEVENLABS_API_KEY=
GROQ_API_KEY=
GOOGLE_PLAY_SERVICE_ACCOUNT_KEY=

# Firebase Client Configuration (auto-provisioned via firebase-applet-config.json)
FIREBASE_PROJECT_ID=audiofactory-eia
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_USE_SAME_ORIGIN_AUTH=

# Early Birds v2.0.0 Lead Capture Security & App Check
EARLY_BIRDS_HMAC_SECRET=
ENFORCE_FIREBASE_APPCHECK=false
VITE_FIREBASE_APPCHECK_SITE_KEY=

# Client-side Monetization Controls
VITE_ADS_ENABLED=
VITE_MONETAG_ENABLED=
VITE_MONETAG_ZONE_PRIMARY=
VITE_MONETAG_ZONE_SECONDARY=
VITE_MONETAG_ZONE_VIGNETTE=
VITE_ADS_SHOW_GUEST=
VITE_ADS_SHOW_FREE=
VITE_ADS_SHOW_PRO=
VITE_ADS_SHOW_LIFETIME=
VITE_ADS_SHOW_WEB=
VITE_ADS_SHOW_ANDROID=
VITE_ADS_SHOW_MARKETING=
VITE_ADS_SHOW_STUDIO=
VITE_ADS_COOLDOWN_SECONDS=
VITE_ADS_MIN_SESSION_SECONDS=

# Admin Console Credentials
ADMIN_USERNAME=
ADMIN_PASSWORD=
